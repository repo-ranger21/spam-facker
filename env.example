# .env — copy this to .env and fill in your values
# Never commit this file to GitHub!

# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+14015550100     # Your Twilio phone number (E.164 format)

# Your public webhook URL (use ngrok for local dev, or your deployed domain)
# Example: https://abc123.ngrok.io  OR  https://spambot.yourdomain.com
BASE_URL=https://your-ngrok-or-domain.com

# Spam detection sensitivity (0–100). 75 = recommended starting point.
SPAM_THRESHOLD=75

# Optional: Nomorobo API key for extra robocall detection
# Get one free at https://www.nomorobo.com/api
NOMOROBO_API_KEY=

# Optional: Override the Rick Roll audio URL with your own hosted MP3
# Must be a publicly accessible HTTPS URL
RICK_ROLL_URL=https://ia803108.us.archive.org/21/items/NeverGonnaGiveYouUp/jocofullinterview__comp.mp3

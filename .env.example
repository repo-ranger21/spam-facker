# Copy this file to .env and fill in your real values.
# Never commit your real .env file.

# Required: Twilio Account SID from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: Twilio Auth Token from the Twilio console
TWILIO_AUTH_TOKEN=your_auth_token_here

# Required: Twilio phone number in E.164 format used to receive and place calls
TWILIO_PHONE_NUMBER=+14015550100

# Required: Public base URL for this app.
# Must exactly match the Twilio webhook URL and must not end with a trailing slash.
# Replit deployment URL — update after first deploy to get exact subdomain
BASE_URL=https://spam-facker.replit.app

# Required: OpenAI API key for voice agent responses.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Required: ElevenLabs API key for generated voice playback.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# Optional: Public URL for the audio file Twilio should play.
# Defaults to ${BASE_URL}/audio/snippet.mp3 when omitted.
RICK_ROLL_URL=

# Optional: Spam score threshold from 0-100. Recommended starting value is 75.
SPAM_THRESHOLD=75

# Optional: Nomorobo API key for extra robocall detection.
NOMOROBO_API_KEY=

# Optional: Runtime port injected by Render, Railway, or local process managers.
PORT=5000

# ---------------------------------------------------------------------------
# Latency sprint feature flags (Phase 1-3)
# Flip each to "true" only after smoke testing in staging.
# ---------------------------------------------------------------------------

# Phase 1: Pre-rendered filler audio — play instantly while LLM+TTS runs in background.
# Run `python -m scripts.generate_fillers` before enabling.
ENABLE_FILLERS=false

# Phase 2: Streaming TTS via ElevenLabs chunked endpoint — start playback before
# full synthesis completes. Enable only after Phase 1 is validated.
ENABLE_STREAMING_TTS=false

# Phase 3: Token cap (max_tokens=60) + history trim (last 6 turns) +
# frequency_penalty=0.3 for shorter, faster, less repetitive responses.
ENABLE_TOKEN_CAP=false

# ---------------------------------------------------------------------------
# Realtime sprint feature flags (OpenAI Realtime API + Twilio Media Streams)
# All default false/0. Ramp REALTIME_TRAFFIC_PERCENT gradually after testing.
# ---------------------------------------------------------------------------

# Master switch — must be "true" before any traffic routes to the realtime path.
ENABLE_REALTIME=false

# Percentage of spam calls to route to realtime (0-100). Increment gradually:
#   0 → internal testing only  →  10 → 25 → 50 → 100
REALTIME_TRAFFIC_PERCENT=0

# When true, if the OpenAI Realtime WS fails to connect, fall back to legacy path.
REALTIME_FALLBACK_TO_LEGACY=true

# OpenAI Realtime model. Only change if OpenAI releases a newer stable version.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
